<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ns2:repository xmlns:ns2="http://schemas.android.com/repository/android/common/02" xmlns:ns5="http://schemas.android.com/repository/android/generic/02" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <localPackage path="@PATH@" obsolete="false">
        <type-details xsi:type="ns5:genericDetailsType"/>
        <revision>
            <major>@MAJOR@</major>
            <minor>@MINOR@</minor>
            <micro>@MICRO@</micro>
        </revision>
        <display-name>@DISPLAY@</display-name>
    </localPackage>
</ns2:repository>

